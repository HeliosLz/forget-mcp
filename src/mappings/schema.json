{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "forget-mcp Curated Mapping",
  "type": "object",
  "required": ["server_patterns", "classification", "cli", "env_vars", "tools", "wrapper_template"],
  "properties": {
    "$schema": { "type": "string" },
    "server_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Strings to match against server name, command, or args in MCP config"
    },
    "classification": {
      "enum": ["tool-type", "service-type"],
      "description": "Whether this server can be replaced by CLI commands"
    },
    "cli": {
      "type": "object",
      "required": ["name", "install", "version_check"],
      "properties": {
        "name": { "type": "string", "description": "Primary CLI tool name" },
        "install": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Install commands by OS (darwin, linux, fallback)"
        },
        "version_check": { "type": "string", "description": "Command to verify CLI is installed" }
      }
    },
    "env_vars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "description"],
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["subcommand", "args"],
        "properties": {
          "subcommand": { "type": "string", "description": "Wrapper subcommand name" },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Named arguments the subcommand accepts"
          },
          "output_format": { "type": "string" },
          "guidance": { "type": "string", "description": "Usage hint for the AI" }
        }
      }
    },
    "wrapper_template": {
      "type": "string",
      "description": "Bash case body for the wrapper script. Hand-written, not generated."
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
