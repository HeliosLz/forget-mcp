{
  "name": "forget-mcp",
  "version": "0.1.2",
  "description": "Convert MCP servers into Skill documents + CLI wrappers. Kill context window overhead.",
  "type": "module",
  "bin": {
    "forget-mcp": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=node --outdir=dist",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "claude-code",
    "context-window",
    "skill",
    "cli"
  ],
  "author": "HeliosLz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeliosLz/forget-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.9",
    "typescript": "^5.8.3"
  }
}
